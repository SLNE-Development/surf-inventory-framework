+        // whether this backend really finalized the session.
+        final boolean closed = closeSession(session, false, CLOSE_ORIGIN_QUIT, true, true);
+        windowTrackers.remove(player.getUniqueId());
+        openingViewers.remove(player.getUniqueId());
