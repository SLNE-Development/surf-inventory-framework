From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: twisti <76837088+twisti-dev@users.noreply.github.com>
Date: Thu, 14 May 2026 12:55:34 +0200
Subject: [PATCH] support updated minecraft version string formats

* add parsing support for versions containing ".build." suffixes
* detect numeric patch version parts when counting version separators
* preserve separator counting for non-patch version formats using dot characters

diff --git a/inventory-framework-platform-bukkit/src/main/java/me/devnatan/inventoryframework/runtime/thirdparty/McVersion.java b/inventory-framework-platform-bukkit/src/main/java/me/devnatan/inventoryframework/runtime/thirdparty/McVersion.java
index 56f4156079642a56f53f95ee6e9b706ce5d9569f..1f2cf9fd34e610ebe3088fd9dc9d2b9452446cbc 100644
--- a/inventory-framework-platform-bukkit/src/main/java/me/devnatan/inventoryframework/runtime/thirdparty/McVersion.java
+++ b/inventory-framework-platform-bukkit/src/main/java/me/devnatan/inventoryframework/runtime/thirdparty/McVersion.java
@@ -7,6 +7,8 @@ public class McVersion implements Comparable<McVersion> {
 
     private static final McVersion CURRENT_VERSION;
 
+	// surf start - support new version format
+	/*
     static {
         final int currentMajor = Integer.parseInt(Bukkit.getBukkitVersion().split("\\.")[0]);
         final int currentMinor =
@@ -18,6 +20,23 @@ public class McVersion implements Comparable<McVersion> {
 
         CURRENT_VERSION = new McVersion(currentMajor, currentMinor, currentPatch);
     }
+	 */
+	static {
+		final String version = Bukkit.getBukkitVersion();
+
+		final String mcVersionPart = version.contains(".build.")
+			? version.substring(0, version.indexOf(".build."))
+			: version.split("-", 2)[0];
+
+		final String[] parts = mcVersionPart.split("\\.");
+
+		final int currentMajor = Integer.parseInt(parts[0]);
+		final int currentMinor = parts.length > 1 ? Integer.parseInt(parts[1]) : 0;
+		final int currentPatch = parts.length > 2 ? Integer.parseInt(parts[2]) : 0;
+
+		CURRENT_VERSION = new McVersion(currentMajor, currentMinor, currentPatch);
+	}
+	// surf end - support new version format
 
     private static int countColons(final String string) {
         int count = 0;
@@ -128,7 +147,11 @@ public class McVersion implements Comparable<McVersion> {
      * @since 4.0.0
      */
     public static boolean supports(int minorNumber) {
-        return CURRENT_VERSION.isAtLeast(1, minorNumber);
+		// surf start - support new version format
+//        return CURRENT_VERSION.isAtLeast(1, minorNumber);
+		if (CURRENT_VERSION.getMajor() > 1) return true;
+		return CURRENT_VERSION.isAtLeast(1, minorNumber);
+		// surf end - support new version format
     }
 
     /**
@@ -141,6 +164,10 @@ public class McVersion implements Comparable<McVersion> {
      * @since 4.0.0
      */
     public static boolean supports(int minorNumber, int patchNumber) {
-        return CURRENT_VERSION.isAtLeast(1, minorNumber, patchNumber);
-    }
+		// surf start - support new version format
+//        return CURRENT_VERSION.isAtLeast(1, minorNumber, patchNumber);
+		if (CURRENT_VERSION.getMajor() > 1) return true;
+		return CURRENT_VERSION.isAtLeast(1, minorNumber, patchNumber);
+		// surf end - support new version format
+	}
 }
