          * (r0,c0), (r1,c0), (r2,c0), ...
          * (r0,c1), (r1,c1), (r2,c1), ...
          * </pre>
-         * </p>
          */
         VERTICAL,
 
@@ -290,12 +289,11 @@ public interface Pagination extends ComponentComposition, StateValue {
          * <p>Slots are traversed from left to right within each row,
          * and rows are processed from top to bottom.</p>
