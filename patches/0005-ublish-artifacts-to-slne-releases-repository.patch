Subject: [PATCH] ublish artifacts to slne releases repository


diff --git a/build-logic/conventions/src/main/kotlin/Publish.kt b/build-logic/conventions/src/main/kotlin/Publish.kt
index 8a3078575c8cac1c3143b1319c0e54a3bdee313a..206cad644f5020cf19eb6fef58db514b57f8e919 100644
--- a/build-logic/conventions/src/main/kotlin/Publish.kt
+++ b/build-logic/conventions/src/main/kotlin/Publish.kt
@@ -1,14 +1,40 @@
 import com.vanniktech.maven.publish.MavenPublishBaseExtension
 import org.gradle.api.Project
+import org.gradle.api.publish.PublishingExtension
+import org.gradle.api.publish.maven.MavenPublication
 import org.gradle.kotlin.dsl.configure
+import org.gradle.kotlin.dsl.create
+import org.gradle.kotlin.dsl.get
+import org.gradle.kotlin.dsl.maven
 
 internal fun Project.configureInventoryFrameworkPublication() {
-    plugins.apply("com.vanniktech.maven.publish.base")
+    // surf start - update publication
+    if (false) {
+        plugins.apply("com.vanniktech.maven.publish.base")
 
-    extensions.configure<MavenPublishBaseExtension> {
-        publishToMavenCentral(automaticRelease = true)
-        signAllPublications()
-        pomFromGradleProperties()
-        configureBasedOnAppliedPlugins()
+        extensions.configure<MavenPublishBaseExtension> {
+            publishToMavenCentral(automaticRelease = true)
+            signAllPublications()
+            pomFromGradleProperties()
+            configureBasedOnAppliedPlugins()
+        }
     }
+    plugins.apply("maven-publish")
+
+    configure<PublishingExtension> {
+        repositories {
+            maven("https://reposilite.slne.dev/releases/") {
+                name = "slne-repository-releases"
+                credentials {
+                    username = System.getenv("SLNE_RELEASES_REPO_USERNAME")
+                    password = System.getenv("SLNE_RELEASES_REPO_PASSWORD")
+                }
+            }
+        }
+
+        publications.create<MavenPublication>("maven") {
+            from(components["java"])
+        }
+    }
+    // surf end - update publication
 }
diff --git a/build.gradle.kts b/build.gradle.kts
index e027a85f1badebeabeae96933fc4f0a46ebccfb0..97ba23dd12be3768cd8f847c844eb7d433bead50 100644
--- a/build.gradle.kts
+++ b/build.gradle.kts
@@ -1,7 +1,7 @@
 plugins {
     alias(libs.plugins.spotless) apply false
     alias(libs.plugins.kotlin) apply false
-    alias(libs.plugins.publish) apply false
+//    alias(libs.plugins.publish) apply false // surf - update publication
 }
 
 // surf start - update build
@@ -25,4 +25,6 @@ fun Project.nextGitTag(): String {
     return "$major.${minor + 1}.0-SNAPSHOT"
 }
  */
+group = "dev.slne.forks.inventoryframework"
+version = "1.0.0"
 // surf end - update build
